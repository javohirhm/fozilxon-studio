# /etc/systemd/system/fozilxon.service
[Unit]
Description=Fozilxon Studio (bot + sayt)
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/fozilxon.uz
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
