# Telegram bot token — @BotFather -> /newbot
BOT_TOKEN=

# Only this Telegram user can use the bot. Send /start to the bot with an empty
# value here and it replies with your ID.
BOT_OWNER_ID=

# Website login password (the only credential — there is no username)
SITE_PASSWORD=

# Random string for signing the login cookie (keep secret, changing it logs everyone out)
SESSION_SECRET=

# Shown in the bot's "Saytda ko'rish" button
SITE_URL=https://pro.javohirhm.uz

PORT=3000
NODE_ENV=production
DB_PATH=data/studio.db
